{
  "name": "@atriarch-systems/tracery-core",
  "version": "0.1.3",
  "license": "Apache-2.0",
  "description": "Tracery Graph wire contract, validation, journal, flow reducers, trace assembly and visualizer projection. No DOM, no React.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/demonslyr"
  },
  "homepage": "https://github.com/Atriarch-Systems/tracery-graph/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/Atriarch-Systems/tracery-graph/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Atriarch-Systems/tracery-graph.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "import": "./dist/fixtures.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/sync-projection-types.mjs && tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
